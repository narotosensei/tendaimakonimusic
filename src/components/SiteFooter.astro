---
import Icons from "./Icons.astro";
import { site } from "../data/content";

const year = new Date().getFullYear();
---

<footer class="bg-gray-900 py-8 text-white">
  <div class="container mx-auto px-4">
    <div class="flex flex-col items-center justify-between gap-4 md:flex-row">
      <div>
        <h3 class="text-2xl font-bold">{site.shortName}</h3>
        <p class="mt-1 text-sm text-gray-400">{site.tagline}</p>
      </div>
      <div class="flex gap-4">
        <a href={site.social.instagram} class="rounded-full bg-white/10 p-2 transition-colors hover:bg-white/20" aria-label="Instagram">
          <Icons name="instagram" class="h-5 w-5" />
        </a>
        <a href={site.social.youtube} class="rounded-full bg-white/10 p-2 transition-colors hover:bg-white/20" aria-label="YouTube">
          <Icons name="youtube" class="h-5 w-5" />
        </a>
        <a href={site.social.x} class="rounded-full bg-white/10 p-2 transition-colors hover:bg-white/20" aria-label="X">
          <Icons name="twitter" class="h-5 w-5" />
        </a>
        <a href={site.social.facebook} class="rounded-full bg-white/10 p-2 transition-colors hover:bg-white/20" aria-label="Facebook">
          <Icons name="facebook" class="h-5 w-5" />
        </a>
      </div>
    </div>
    <div class="mt-8 text-center text-sm text-gray-400">
      <p>© {year} {site.shortName}. All rights reserved.</p>
      <button type="button" data-cookie-open class="mt-2 text-gray-300 underline-offset-2 hover:text-white hover:underline">
        Cookie settings
      </button>
    </div>
  </div>
</footer>
