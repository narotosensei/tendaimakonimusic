---
import ThemeToggle from "./ThemeToggle.astro";
import { site } from "../data/content";
---

<section class="relative overflow-hidden bg-white py-16 dark:bg-gray-900">
  <div class="absolute right-4 top-4 z-20 text-gray-800 dark:text-white">
    <ThemeToggle />
  </div>

  <div class="absolute inset-0 overflow-hidden">
    <div
      class="wave absolute h-[300px] w-[1500px] opacity-20 dark:opacity-30"
      style="top:-100px;left:-200px;background:linear-gradient(45deg,#008000,transparent);border-radius:43%;animation:wave 15s infinite linear;transform-origin:center center"
    >
    </div>
    <div
      class="wave absolute h-[250px] w-[1500px] opacity-20 dark:opacity-30"
      style="top:-50px;right:-200px;background:linear-gradient(45deg,#e60000,transparent);border-radius:40%;animation:wave 17s infinite linear reverse;transform-origin:center center"
    >
    </div>
    <div
      class="wave absolute h-[200px] w-[1200px] opacity-10 dark:opacity-20"
      style="bottom:-80px;left:-100px;background:linear-gradient(45deg,#000000,transparent);border-radius:38%;animation:wave 20s infinite linear;transform-origin:center center"
    >
    </div>
    <div
      class="wave absolute h-[220px] w-[1300px] opacity-20 dark:opacity-30"
      style="bottom:-70px;right:-150px;background:linear-gradient(45deg,#ff9900,transparent);border-radius:42%;animation:wave 18s infinite linear reverse;transform-origin:center center"
    >
    </div>
  </div>

  <div class="container relative z-10 mx-auto px-4 text-center" data-banner>
    <div class="relative inline-block">
      <h1 class="animate-text bg-gradient-to-r from-green-600 via-red-600 to-amber-500 bg-clip-text text-5xl font-bold text-transparent drop-shadow-lg sm:text-6xl md:text-7xl">
        {site.name}
      </h1>
      <div class="absolute -inset-1 -z-10 blur-lg">
        <p class="text-5xl font-bold text-black/20 dark:text-white/20 sm:text-6xl md:text-9xl">{site.name}</p>
      </div>
    </div>
    <div class="mt-6 flex items-center justify-center gap-4">
      <div class="h-1 w-16 rounded-full bg-green-600"></div>
      <span class="text-xl font-medium text-gray-700 dark:text-gray-300">{site.role}</span>
      <div class="h-1 w-16 rounded-full bg-red-600"></div>
    </div>
  </div>
</section>

<script>
  const banner = document.querySelector<HTMLElement>("[data-banner]");
  if (banner) {
    window.addEventListener("mousemove", (event) => {
      const rect = banner.getBoundingClientRect();
      const x = (event.clientX - rect.left) / rect.width - 0.5;
      const y = (event.clientY - rect.top) / rect.height - 0.5;
      document.querySelectorAll<HTMLElement>(".wave").forEach((wave, index) => {
        const factor = (index + 1) * 5;
        wave.style.translate = `${x * factor}px ${y * factor}px`;
      });
    });
  }
</script>
