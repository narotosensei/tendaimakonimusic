---
import { imageVariants } from "../lib/images";

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "lazy" | "eager";
  fetchpriority?: "high" | "low" | "auto";
  width?: number;
  height?: number;
  sizes?: string;
}

const {
  src,
  alt,
  class: className = "",
  loading = "lazy",
  fetchpriority = "auto",
  width,
  height,
  sizes,
} = Astro.props;

const { fallback, webp, avif } = imageVariants(src);
---

<picture>
  <source srcset={avif} type="image/avif" sizes={sizes} />
  <source srcset={webp} type="image/webp" sizes={sizes} />
  <img
    src={fallback}
    alt={alt}
    class={className}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    width={width}
    height={height}
    sizes={sizes}
  />
</picture>
