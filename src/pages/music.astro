---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icons from "../components/Icons.astro";
import MusicPlatforms from "../components/MusicPlatforms.astro";
import OptimizedImage from "../components/OptimizedImage.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { tracks, site } from "../data/content";

const featured = tracks.find((track) => track.title === "Fulfill") ?? tracks[0];
const singles = tracks.filter((track) => track.tab === "singles");
---

<BaseLayout title={`Music | ${site.name}`} description="Listen to Tendai's powerful worship songs across all major platforms.">
  <div class="min-h-screen py-16">
    <div class="container mx-auto px-4">
      <p class="mb-6">
        <a href="/" class="text-green-700 hover:underline dark:text-green-400">← Back home</a>
      </p>
      <div class="mb-12 text-center">
        <h1 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl">Music</h1>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">Listen to Tendai's powerful worship songs across all major platforms</p>
      </div>

      <div class="mb-16 overflow-hidden rounded-xl bg-gradient-to-r from-green-900 to-red-900 shadow-xl">
        <div class="grid items-center gap-6 p-6 md:grid-cols-2 md:gap-12 md:p-8 lg:p-12">
          <div class="order-2 text-white md:order-1">
            <div class="inline-flex items-center rounded-full bg-white/20 px-3 py-1 text-sm font-medium">
              <Icons name="music" class="mr-1 h-4 w-4" /> Latest Release
            </div>
            <h2 class="mt-4 text-3xl font-bold md:text-4xl">{featured.title}</h2>
            <p class="mt-4 text-white/80">
              Tendai's latest powerful worship anthem that speaks to God's faithfulness in fulfilling His promises in our lives.
            </p>
            <div class="mt-6">
              <MusicPlatforms class="justify-start" showLabels spotify={featured.spotify} apple={featured.apple} youtube={featured.youtube} boomplay={featured.boomplay} />
            </div>
            <div class="mt-8">
              <a href={featured.listenUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center rounded-md bg-white px-6 py-3 text-lg font-medium text-green-900 hover:bg-white/90">
                <Icons name="play" class="mr-2 h-5 w-5" /> Listen Now
              </a>
            </div>
          </div>
          <div class="order-1 md:order-2">
            <div class="relative aspect-square overflow-hidden rounded-lg">
              <OptimizedImage src={featured.cover} alt={`${featured.title} - Tendai Makoni`} class="h-full w-full object-cover" width={800} height={800} sizes="(min-width: 768px) 50vw, 100vw" />
            </div>
          </div>
        </div>
      </div>

      <div class="mb-16">
        <h2 class="mb-8 text-2xl font-bold text-gray-900 dark:text-white md:text-3xl">Singles</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            singles.map((track) => (
              <article class="overflow-hidden rounded-xl bg-white shadow-lg dark:bg-gray-900">
                <div class="aspect-square overflow-hidden bg-black/5">
                  <OptimizedImage src={track.cover} alt={track.title} class="h-full w-full object-cover transition-transform hover:scale-105" width={600} height={600} sizes="(min-width: 1024px) 25vw, 50vw" />
                </div>
                <div class="p-4">
                  <h3 class="text-xl font-bold text-gray-900 dark:text-white">{track.title}</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{track.subtitle}</p>
                  <div class="mt-4 flex items-center justify-between">
                    <a href={track.listenUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 rounded-md bg-green-700 px-3 py-1.5 text-sm text-white hover:bg-green-800">
                      <Icons name="play" class="h-4 w-4" /> Listen
                    </a>
                    <span class="text-sm font-medium">{track.duration}</span>
                  </div>
                  <MusicPlatforms class="mt-4" spotify={track.spotify} apple={track.apple} youtube={track.youtube} boomplay={track.boomplay} />
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <div>
        <h2 class="mb-8 text-2xl font-bold text-gray-900 dark:text-white md:text-3xl">In the Studio</h2>
        <div class="grid gap-8 md:grid-cols-2">
          <div class="overflow-hidden rounded-xl">
            <OptimizedImage src="/images/hero-studio-keyboard.jpg" alt="Tendai in the studio with keyboard" class="h-full w-full object-cover" width={900} height={700} sizes="(min-width: 768px) 50vw, 100vw" />
          </div>
          <div class="overflow-hidden rounded-xl">
            <OptimizedImage src="/images/hero-recording.jpg" alt="Tendai recording with microphone" class="h-full w-full object-cover" width={900} height={700} sizes="(min-width: 768px) 50vw, 100vw" />
          </div>
        </div>
        <div class="mt-8 text-center">
          <p class="mx-auto max-w-2xl text-gray-600 dark:text-gray-300">
            Tendai is constantly working on new music to inspire worship and bring God's presence to her listeners. Follow her on social media to stay updated on upcoming releases and behind-the-scenes content.
          </p>
          <a href="/#contact" class="mt-6 inline-flex rounded-md bg-gradient-to-r from-green-600 to-red-600 px-6 py-3 font-medium text-white hover:from-green-700 hover:to-red-700">
            Subscribe for Updates
          </a>
        </div>
      </div>
    </div>
  </div>
  <SiteFooter />
</BaseLayout>
